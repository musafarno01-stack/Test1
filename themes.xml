<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CalculatorApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <style name="Widget.Calculator.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/fg_light</item>
        <item name="backgroundTint">@color/digit_bg</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:insetLeft">4dp</item>
        <item name="android:insetRight">4dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Calculator.Button.Operator">
        <item name="android:textColor">@color/accent_orange</item>
        <item name="backgroundTint">@color/operator_bg</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="Widget.Calculator.Button.Equals">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/equals_bg</item>
        <item name="android:textSize">32sp</item>
    </style>
</resources>
